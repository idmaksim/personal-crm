# PostgreSQL (local, Docker)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app (Drizzle / Next.js server)
# postgresql://<user>:<password>@localhost:<port>/<db>
DATABASE_URL=

# Better Auth
# BETTER_AUTH_SECRET: random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Mail sending (Nodemailer). Locally and in tests this points at the Mailpit
# stub started by `docker compose up -d mailpit` — no auth, no TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@mail.crm.localhost

# Email of the user who becomes the owner of all data that existed before this
# feature shipped (set once, used by the migration and by `db:seed`).
OWNER_EMAIL=

# Only used in production, where mail goes out through Resend's SMTP.
RESEND_API_KEY=
