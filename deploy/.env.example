# Server-side secrets for the production stack.
# Copy this to ~/deploy/.env on the server and fill in real values.
# This file (.env.example) is the template; the real .env is never in git.

# Database (used by the postgres container AND the app)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string the app uses. Host is the compose service name "postgres".
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=
