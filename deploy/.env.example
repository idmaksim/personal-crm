# Server-side secrets for the app stack. This file (.env.example) is the
# template; the real env files are created on the server by hand and are never
# in git.
#
# Two environments live on the same server, each with its own env file:
#   ~/deploy/.env           -> production   (deploy.sh <image>)
#   ~/deploy/.env.staging   -> test stand   (deploy.sh <image> staging)
# Both use the keys below. See "TEST STAND" at the bottom for what differs on
# the stand. deploy.sh sets the container names, port and memory limits itself,
# so those are NOT put in the env file.
#
# --- PRODUCTION (~/deploy/.env) ---------------------------------------------
# Copy this to ~/deploy/.env on the server and fill in real values.

# Database (used by the postgres container AND the app)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string the app uses. Host is the compose service name "postgres".
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=

# Public URL of the app. When set, deploy.sh does a public smoke test through
# nginx/HTTPS after the container is up, catching nginx misconfigs. Optional but
# recommended. Example: https://app.dobrymaxx.ru
PUBLIC_APP_URL=

# Better Auth
# BETTER_AUTH_SECRET: random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (same value as PUBLIC_APP_URL above).
BETTER_AUTH_URL=

# Mail sending (Nodemailer) through Resend's SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=noreply@mail.crm.dobrymaxx.ru
RESEND_API_KEY=

# Email of the user who becomes the owner of all data that existed before this
# feature shipped. Used once by the migration step; leave set after that.
OWNER_EMAIL=

# --- TEST STAND (~/deploy/.env.staging) -------------------------------------
# The stand reuses every key above; create ~/deploy/.env.staging from this same
# template (chmod 600), with these differences:
#
#   POSTGRES_* / DATABASE_URL  Its OWN database — use different credentials and
#                              DB name from prod. DATABASE_URL still points at
#                              host "postgres" (it resolves inside the stand's
#                              own compose network):
#                              postgresql://<user>:<pass>@postgres:5432/<db>
#   PUBLIC_APP_URL             https://test-app.dobrymaxx.ru
#   BETTER_AUTH_URL            https://test-app.dobrymaxx.ru  (so the login link
#                              in the email points at the stand, not prod)
#   BETTER_AUTH_SECRET         Its OWN random secret (openssl rand -base64 32)
#   SMTP_* / MAIL_FROM /       Same as prod (login emails go out via Resend; a
#   RESEND_API_KEY / OWNER_EMAIL   login email only reaches whoever requests it)
#
# The stand makes NO backup (its data is disposable) and reseeds its database
# from a fresh copy of prod on every deploy, so anything changed on the stand
# is overwritten at the next deploy. deploy.sh skips the stand entirely until
# this file exists, so prod deploys are never blocked by an unconfigured stand.
