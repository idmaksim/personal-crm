# Server-side secrets for the production stack.
# Copy this to ~/deploy/.env on the server and fill in real values.
# This file (.env.example) is the template; the real .env is never in git.

# Database (used by the postgres container AND the app)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string the app uses. Host is the compose service name "postgres".
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=

# Public URL of the app. When set, deploy.sh does a public smoke test through
# nginx/HTTPS after the container is up, catching nginx misconfigs. Optional but
# recommended. Example: https://app.dobrymaxx.ru
PUBLIC_APP_URL=

# Better Auth
# BETTER_AUTH_SECRET: random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (same value as PUBLIC_APP_URL above).
BETTER_AUTH_URL=

# Mail sending (Nodemailer) through Resend's SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=noreply@mail.crm.dobrymaxx.ru
RESEND_API_KEY=

# Email of the user who becomes the owner of all data that existed before this
# feature shipped. Used once by the migration step; leave set after that.
OWNER_EMAIL=
